{"nodes": [{"id": "docs_architecture_layering", "label": "Layered architecture (Game -> Virtual LAN -> Router -> Peer Manager -> Transport)", "file_type": "rationale", "source_file": "docs/architecture.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing above the transport line may learn which transport carries a packet, so WebRTC/UDP/relay are swappable without edits above."}, {"id": "docs_architecture_transport_interface", "label": "transport.Transport interface", "file_type": "code", "source_file": "docs/architecture.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_optional_transport_interfaces", "label": "Signalling / ControlTransport / ControlReceiver / StateReporter", "file_type": "code", "source_file": "docs/architecture.md", "source_location": "L96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept beside Transport rather than inside it so a raw-UDP transport cannot return a fake success; non-capable transports report a clean capability failure."}, {"id": "docs_architecture_webrtc_transport", "label": "WebRTC transport (Pion, STUN/ICE)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L88", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_peer_state_machine", "label": "Peer state machine (core/internal/peer)", "file_type": "rationale", "source_file": "docs/architecture.md", "source_location": "L107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly one owner: two state machines could disagree; transport reports mechanical facts, transition table refuses non-forward transitions so late Pion callbacks cannot resurrect a dead link."}, {"id": "docs_architecture_desktop_shell", "label": "Tauri desktop shell (Rust)