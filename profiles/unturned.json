{
  "id": "unturned",
  "name": "Unturned",
  "version": 1,
  "executables": {
    "windows": [
      "unturned.exe"
    ],
    "linux": [],
    "macos": []
  },
  "network": {
    "protocol": "udp",
    "ports": [
      27015,
      27016
    ],
    "broadcast": true,
    "multicast": false,
    "discovery_ports": [
      27015
    ]
  },
  "discovery": {
    "type": "broadcast"
  },
  "firewall": {
    "required": true,
    "protocols": [
      "udp"
    ],
    "ports": [
      27015,
      27016
    ],
    "scope": "private"
  },
  "join_hint": "Host a server; others Servers → LAN.",
  "notes": "Steam LAN listing.",
  "join_uri": "steam://connect/{host}:{port}"
}
