{
  "id": "garrys-mod",
  "name": "Garry's Mod",
  "version": 1,
  "executables": {
    "windows": [
      "gmod.exe",
      "hl2.exe"
    ],
    "linux": [],
    "macos": []
  },
  "network": {
    "protocol": "udp",
    "ports": [
      27015
    ],
    "broadcast": true,
    "multicast": false,
    "discovery_ports": [
      27015
    ]
  },
  "discovery": {
    "type": "broadcast"
  },
  "firewall": {
    "required": true,
    "protocols": [
      "udp"
    ],
    "ports": [
      27015
    ],
    "scope": "private"
  },
  "join_hint": "Start a LAN game; others find it in the LAN tab.",
  "notes": "Source engine LAN broadcast on 27015.",
  "join_uri": "steam://connect/{host}:{port}",
  "path_hints": [
    "garrysmod"
  ]
}
