{
  "id": "trackmania-nations",
  "name": "TrackMania Nations Forever",
  "version": 1,
  "executables": {
    "windows": [
      "tmforever.exe"
    ],
    "linux": [],
    "macos": []
  },
  "network": {
    "protocol": "both",
    "ports": [
      2350,
      3450
    ],
    "broadcast": true,
    "multicast": false,
    "discovery_ports": [
      2350
    ]
  },
  "discovery": {
    "type": "broadcast"
  },
  "firewall": {
    "required": true,
    "protocols": [
      "tcp",
      "udp"
    ],
    "ports": [
      2350,
      3450
    ],
    "scope": "private"
  },
  "join_hint": "LAN → Create; others see the server in the LAN list.",
  "notes": "LAN discovery uses broadcast."
}
