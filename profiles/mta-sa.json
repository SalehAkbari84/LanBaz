{
  "id": "mta-sa",
  "name": "Multi Theft Auto: San Andreas",
  "version": 1,
  "executables": {
    "windows": [
      "multi theft auto.exe",
      "mta server.exe"
    ],
    "linux": [],
    "macos": []
  },
  "network": {
    "protocol": "udp",
    "ports": [
      22003,
      22126
    ],
    "broadcast": true,
    "multicast": false,
    "discovery_ports": [
      22126
    ]
  },
