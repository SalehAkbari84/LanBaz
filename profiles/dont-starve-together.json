{
  "id": "dont-starve-together",
  "name": "Don't Starve Together",
  "version": 1,
  "executables": {
    "windows": [
      "dontstarve_steam.exe",
      "dontstarve_steam_x64.exe"
    ],
    "linux": [],
    "macos": []
  },
  "network": {
    "protocol": "udp",
    "ports": [
      10999
    ],
    "broadcast": true,
    "multicast": false,
    "discovery_ports": [
      10999
    ]
  },
  "discovery": {
    "type": "broadcast"
  },
  "firewall": {
    "required": true,
    "protocols": [
      "udp"
    ],
    "ports": [
      10999
    ],
    "scope": "private"
  },
  "join_hint": "Host Game with LAN only; others Browse Games → LAN.",
  "notes": "LAN-only servers are discovered by broadcast."
}
