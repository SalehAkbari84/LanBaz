{
  "id": "warcraft3",
  "name": "Warcraft III",
  "version": 1,
  "executables": {
    "windows": [
      "war3.exe",
      "warcraft iii.exe",
      "frozen throne.exe"
    ],
    "linux": [],
    "macos": []
  },
  "network": {
    "protocol": "both",
    "ports": [
      6112
    ],
    "broadcast": true,
    "multicast": false,
    "discovery_ports": [
      6112
    ]
  },
  "discovery": {
